# ---- 基础 ----
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://data/nodeauth.db
PUBLIC_BASE_URL=https://auth.example.com

# ---- 后台管理员 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# ---- 默认授权策略 ----
DEFAULT_MAX_DEVICES=1
DEFAULT_VALID_DAYS=30
TOKEN_TTL_DAYS=7

# ---- 防订阅/凭据外传 ----
# /sub/:key 是否必须携带已绑定设备的指纹（fp= 参数）
SUB_REQUIRE_FP=true
# 每个 Token 允许的同时在线来源 IP 数（0=不限制）
MAX_ONLINE_IPS=3
# 在线 IP 记录空闲多久后释放名额（秒）
ONLINE_IP_TTL_SECS=600

# ---- 邮件（Gmail 应用专用密码）----
# 465=隐式 TLS；587=STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=youraddress@gmail.com
ADMIN_EMAIL=admin-notify@gmail.com

# ---- Telegram（可选）----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ADMIN_CHAT_ID=123456789
